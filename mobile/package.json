{
  "name": "carpenterpro-mobile",
  "version": "1.0.0",
  "description": "React Native mobile app for CarpenterPro",
  "author": "Gennadiy Zhigin",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:ios": "cd ios && xcodebuild -workspace CarpenterPro.xcworkspace -scheme CarpenterPro -configuration Release",
    "build:android": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-screens": "^3.26.0",
    "react-native-safe-area-context": "^4.7.0",
    "react-native-gesture-handler": "^2.14.0",
    "axios": "^1.6.2",
    "zustand": "^4.4.0",
    "react-native-vector-icons": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.3.2",
    "jest": "^29.7.0"
  }
}
